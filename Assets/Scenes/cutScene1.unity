--- !u!114 &402897035
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 402897033}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad6e5df42940bed4a8a6cd8d90e79efa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogues:
  - speaker: Ryan
    text: " \u201CDesa Karang Turi. Krisis air Bersih\u2026 tapi hasil panen mereka
      nomor satu di kabupaten ini.\u201D"
    pfp: {fileID: 1102108819684225473, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    image: {fileID: 6799216245798168510, guid: 9c671fba460bbea47a2d5e138ebd0e7c, type: 3}
  - speaker: bima
    text: " \u201CKok bisa sih, tempat kek gitu tuh biasanya nggak normal, Yan.\"\r\n"
    pfp: {fileID: 0}
    image: {fileID: 8257921945241284986, guid: db888c91a081ccf4a93006176e280c5e, type: 3}
  - speaker: Tari
    text: "\u201CJustru itu. ini bukan sekadar konten, kita bisa cari tau kok bisa
      gitu.\u201D\r\n"
    pfp: {fileID: 0}
    image: {fileID: 8257921945241284986, guid: db888c91a081ccf4a93006176e280c5e, type: 3}
  - speaker: Ryan
    text: "\u201CKalau teknologi filter ini berhasil dan masalah pangan ini diketahui
      kita bisa bantu lebih banyak tempat, ini jadi langkah awal kita.\u201D\r\n"
    pfp: {fileID: 0}
    image: {fileID: -4748702184737024587, guid: f39f245b36ce7a641992732b5266bb2a, type: 3}
  dialoguePanel: {fileID: 1264060447}
  nameText: {fileID: 1310336530}
  dialogueText: {fileID: 445350839}
  pfpImage: {fileID: 139102795}
  bgImage: {fileID: 987774963}
  nextKey: 101
  typingSpeed: 0.05
