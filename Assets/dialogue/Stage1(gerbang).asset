  lines:
  - speaker: Ryan
    text: Akhirnya sampe..
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Bima
    text: Iya yan. tapi desanya agak sepi ya..
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Iya, kayak gak ada kehidupan
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Ayo masuk desanya, pak Edi udah nungguin kita ini
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
