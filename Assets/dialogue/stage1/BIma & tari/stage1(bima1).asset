  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: stage1(bima1)
  m_EditorClassIdentifier: 
  lines:
  - speaker: Ryan
    text: Eh bim, lu denger gak?
    pfp: {fileID: 6309481852587283508, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Bima
    text: Hmmmmp, denger apaan sih?
    pfp: {fileID: -7002701647214073610, guid: dfc1975b2cf66844398eeeab78053529, type: 3}
    background: {fileID: 0}
  - speaker: Bima
    text: Udahlah, jangan nakutin gua.
    pfp: {fileID: -2230173363425985799, guid: 327e8b9cd5e381945af7f08cf069f539, type: 3}
    background: {fileID: 0}
  - speaker: Bima
    text: Ganggu orang tidur lu.
    pfp: {fileID: -2230173363425985799, guid: 327e8b9cd5e381945af7f08cf069f539, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: (dalam hati) Apa cuma gua yang denger ya?
    pfp: {fileID: 1013065734079282708, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Gua ke toilet bentar.
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Bima
    text: hmmm.
    pfp: {fileID: -2230173363425985799, guid: 327e8b9cd5e381945af7f08cf069f539, type: 3}
    background: {fileID: 0}
