  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: stage1(tari1)
  m_EditorClassIdentifier: 
  lines:
  - speaker: Tari
    text: nahh, sikebo aru bangun.
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: 'Ryan '
    text: Enak aja kebo, masih pagi ini.
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: wkwkwk, kebo mah mana mau ngaku dia kebo.
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Makan gih, DiBelakang ada singkong rebus.
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Singkong dari mana?
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: 'Pak Edi tadi bawain singkong rebus. '
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Gak ah, gak doyan. Btw Bima kemana Tar?
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Tadi ke toilet.
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: ohh, bilang hati-hati kalo ketoilet, ntar didatengin penunggunya, wkwkwk
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: heh, jangan becanda gitu, gak baik.
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Wkwkwk, udah ah, mau keliling dulu.
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
