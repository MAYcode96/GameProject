  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: cutScene3
  m_EditorClassIdentifier: 
  lines:
  - speaker: Ryan
    text: Kalian denger sesuatu ?
    pfp: {fileID: -96499732858103741, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: Gak ada.
    pfp: {fileID: -6066889950362200663, guid: 65461db03521c4e429a106afcb745c88, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: Denger apa ?
    pfp: {fileID: -6066889950362200663, guid: 65461db03521c4e429a106afcb745c88, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Ryan
    text: 'Ada yang bisikin aku, katanya kita disuruh menemui mbah wongso, karna
      dia tau sesuatu. '
    pfp: {fileID: 1102108819684225473, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Pak Edi
    text: Mbah wongso emang tetua disini, tapi kewarasannya udah kurang.
    pfp: {fileID: -788803216113979503, guid: a30c7ceb88c122849bff8826c19118bd, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Pak Edi
    text: 'Mungkin dia memang tau sesuatu. '
    pfp: {fileID: 8285764644026358973, guid: 8346703025be1ba4eba9772ca334deae, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: 'Okelah, besok kita temui mbah wonso. '
    pfp: {fileID: -415842496510086475, guid: 9730004f7056abe41b3df2ef91757386, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: Mungkin ada petunjuk buat mutusin perjanjian ini.
    pfp: {fileID: -415842496510086475, guid: 9730004f7056abe41b3df2ef91757386, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
