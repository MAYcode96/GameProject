  m_Name: cutScene3
  m_EditorClassIdentifier: 
  lines:
  - speaker: Ryan
    text: kalian denger sesuatu ?
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: gak ada
    pfp: {fileID: -1933487740984656095, guid: 5e312c1317de02f45a004d6a8d002e9f, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: Denger apa ?
    pfp: {fileID: -1933487740984656095, guid: 5e312c1317de02f45a004d6a8d002e9f, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Ryan
    text: 'ada yang bisikin aku, katanya kita disuruh menemui mbah wongso, karna
      dia tau sesuatu '
    pfp: {fileID: -716451372785500452, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Pak Edi
    text: mbah wongso emang tetua disini, tapi kewarrasannya udah kurang.
    pfp: {fileID: 8285764644026358973, guid: 8346703025be1ba4eba9772ca334deae, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Pak Edi
    text: 'mungkin dia emang tau sesuatu '
    pfp: {fileID: 8285764644026358973, guid: 8346703025be1ba4eba9772ca334deae, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: 'okelah, besok kita temui mbah wonso. '
    pfp: {fileID: -5274776722447701125, guid: f96bda2b016d3f14684c0afc9c34c5ad, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
  - speaker: Tari
    text: munkin ada petunjuk buat mutusin perjanjian ini.
    pfp: {fileID: -5274776722447701125, guid: f96bda2b016d3f14684c0afc9c34c5ad, type: 3}
    background: {fileID: 3375232501854110699, guid: 0f7a3a2d8dacd3342b94b339846a67c5, type: 3}
