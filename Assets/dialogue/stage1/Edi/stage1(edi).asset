  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: stage1(edi)
  m_EditorClassIdentifier: 
  lines:
  - speaker: Pak Edi
    text: Selamat datang di desa kami mas dan mbak.
    pfp: {fileID: -8036185341388125364, guid: 1764f493c99d9ab48b023332f824f8d8, type: 3}
    background: {fileID: 0}
  - speaker: Pak Edi
    text: 'Desa sekarang udah mulai sepi '
    pfp: {fileID: -8036185341388125364, guid: 1764f493c99d9ab48b023332f824f8d8, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Iya pak, makasih juga kami udah di izinin nginap di villa bapak.
    pfp: {fileID: 8660902975792385251, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Emang Desanya sepi karna apa pak ?
    pfp: {fileID: -6066889950362200663, guid: 65461db03521c4e429a106afcb745c88, type: 3}
    background: {fileID: 0}
  - speaker: Pak Edi
    text: Eeem...
    pfp: {fileID: 5570383140744436207, guid: 432adc55f3a2a7a40985e8ec764680df, type: 3}
    background: {fileID: 0}
  - speaker: Pak Edi
    text: Mungkin mereka gak betah kali ya mbak, hahaha...
    pfp: {fileID: -8036185341388125364, guid: 1764f493c99d9ab48b023332f824f8d8, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Oh gitu ya pak..
    pfp: {fileID: 8507451965802014258, guid: e4c7652af4c4b8242b68a68b7e735ac6, type: 3}
    background: {fileID: 0}
  - speaker: Pak Edi
    text: Ya sudah, ayo saya antar ke villanya.
    pfp: {fileID: 6921746131002953608, guid: c54b0a69481ea4d41becdb90c8c6315e, type: 3}
    background: {fileID: 0}
