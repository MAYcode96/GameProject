  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: stage1(edi)
  m_EditorClassIdentifier: 
  lines:
  - speaker: Pak Edi
    text: Selamat datang di desa kami mas dan mbak.
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Pak Edi
    text: 'Desa sekarang udah mulai sepi '
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Iya pak, makasih juga kami udah di izinin nginap di villa bapak.
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Emang Desanya sepi karna apa pak ?
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Pak Edi
    text: Eeem...
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Pak Edi
    text: Mungkin mereka gak betah kali ya mbak, hahaha...
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Oh gitu ya pak..
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Ya sudah, ayo saya antar ke villanya.
    pfp: {fileID: 3184939432797331818, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
