  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: stage(Asep2)
  m_EditorClassIdentifier: 
  lines:
  - speaker: Asep
    text: hei, kalian yang kemaren kan?
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: iya bang.
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: Udah ketemu sama Pak Edi?
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: 'Udah bang. '
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: untung abang ngasih tau.
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: Jaga-jaga aja ya.
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: 'jaga-jaga apasih bang? '
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: ada apa emang?
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: Yaaa, jaga-jaga aja.
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Okelah bang.
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
