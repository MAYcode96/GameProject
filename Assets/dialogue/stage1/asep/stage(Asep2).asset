  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: stage(Asep2)
  m_EditorClassIdentifier: 
  lines:
  - speaker: Asep
    text: Hei, kalian yang kemaren kan?
    pfp: {fileID: 7034776713325852060, guid: af628510890700040a849418ca2747c5, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: iya bang.
    pfp: {fileID: -716451372785500452, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: Udah ketemu sama Pak Edi?
    pfp: {fileID: -7718081434650959245, guid: c01a9cd58d4ca29418dee34664403a23, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: 'Udah bang. '
    pfp: {fileID: -716451372785500452, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: untung abang ngasih tau.
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: Jaga-jaga aja ya.
    pfp: {fileID: 7034776713325852060, guid: af628510890700040a849418ca2747c5, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: 'jaga-jaga apasih bang? '
    pfp: {fileID: 8502151928475952583, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: ada apa emang?
    pfp: {fileID: -96499732858103741, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: Yaaa, jaga-jaga aja.
    pfp: {fileID: -5674450265020813633, guid: 0e5d99fe6cd1c4846b4878bca818a9c9, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Okelah bang.
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
