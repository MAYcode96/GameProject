  lines:
  - speaker: Ryan
    text: Bang, tau vilanya pak edi gak yah?
    pfp: {fileID: 8660902975792385251, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: "Kalian tamu villa itu?\r"
    pfp: {fileID: -5674450265020813633, guid: 0e5d99fe6cd1c4846b4878bca818a9c9, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: "Iya bang, mau liburan.\r"
    pfp: {fileID: 8660902975792385251, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: "Sekalian ngenalin teknologi kami ke desa ini.\r"
    pfp: {fileID: -647588791701333756, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Asep
    text: Ohhh. Hati-hati aja ya.
    pfp: {fileID: -5674450265020813633, guid: 0e5d99fe6cd1c4846b4878bca818a9c9, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: ???
    pfp: {fileID: -96499732858103741, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
