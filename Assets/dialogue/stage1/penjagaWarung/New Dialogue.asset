  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: New Dialogue
  m_EditorClassIdentifier: 
  lines:
  - speaker: Bu Warung
    text: 'mau beli apa dek ?

'
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: ' kerupuk sama teh galon buk.

'
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Penjaga Warung
    text: oke, semua jadi 3 ribu ya.
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Penjaga Warung
    text: Kalian kesini ngapain dek, ada keluarga yang dikunjungi ya ?
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: oh enggak buk. kami dengar disini lagi krisis air bersih, jadi kami mau
      bantu.
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: "dan mau cari tau kok desa ini bisa punya hasil panen yang berlimpah, siapa
      tau bisa bermanfaat buat desa lainnya.\r"
    pfp: {fileID: 8050617974308029505, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
