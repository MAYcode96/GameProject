  lines:
  - speaker: Ryan
    text: Kacau nih vila, belum sehari udah ganggu aja.
    pfp: {fileID: -96499732858103741, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Langsung ke kamar aja kali ya.
    pfp: {fileID: -96499732858103741, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
  - speaker: Ryan
    text: Tari Bima juga udah pada tidur kali kayaknya
    pfp: {fileID: -96499732858103741, guid: 717fe866f10db74429e9a9133c64ab34, type: 3}
    background: {fileID: 0}
