  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 63900ac93b90d764abfce22b4b5e61b6, type: 3}
  m_Name: wongso3 1
  m_EditorClassIdentifier: 
  lines:
  - speaker: Tari
    text: Misi mbah, kami mau nanya sesuatu.
    pfp: {fileID: 8507451965802014258, guid: e4c7652af4c4b8242b68a68b7e735ac6, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Apa mbah tau sesuatu tentang moster dan perjanjian leluhur desa ini?
    pfp: {fileID: 8507451965802014258, guid: e4c7652af4c4b8242b68a68b7e735ac6, type: 3}
    background: {fileID: 0}
  - speaker: Mbah wongso
    text: 'AHAHAHAH, tanaman merambat itu. '
    pfp: {fileID: -4966511228610615359, guid: b26c53c2aede3034684a95a69666d7ad, type: 3}
    background: {fileID: 0}
  - speaker: Mbah wongso
    text: Untuk apa kalian tahu tentang itu ?
    pfp: {fileID: -4966511228610615359, guid: b26c53c2aede3034684a95a69666d7ad, type: 3}
    background: {fileID: 0}
  - speaker: Mbah wongso
    text: Kalian akan mati nanti, ahahahah
    pfp: {fileID: -4966511228610615359, guid: b26c53c2aede3034684a95a69666d7ad, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: Apa mbah tahu cara mutusin perjanjian dengan monster itu?
    pfp: {fileID: 8507451965802014258, guid: e4c7652af4c4b8242b68a68b7e735ac6, type: 3}
    background: {fileID: 0}
  - speaker: Tari
    text: 'Tolong kami mbah '
    pfp: {fileID: 8507451965802014258, guid: e4c7652af4c4b8242b68a68b7e735ac6, type: 3}
    background: {fileID: 0}
  - speaker: mbah Wongso
    text: karna waktu sudah singkat, saya langsung beri kalian kekuatan
    pfp: {fileID: -4966511228610615359, guid: b26c53c2aede3034684a95a69666d7ad, type: 3}
    background: {fileID: 0}
  - speaker: mbah Wongso
    text: sekarang kalian udah dapet kekuatan
    pfp: {fileID: -4966511228610615359, guid: b26c53c2aede3034684a95a69666d7ad, type: 3}
    background: {fileID: 0}
  - speaker: mbah Wongso
    text: masuk kedalam lubang itu dan kalahkan monster itu.
    pfp: {fileID: -4966511228610615359, guid: b26c53c2aede3034684a95a69666d7ad, type: 3}
    background: {fileID: 0}
